<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Shared shape for anything a customer can be served across. -->
  <ThingDef Name="OWT_CounterBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>false</blockWind>
    <fillPercent>0.5</fillPercent>
    <pathCost>50</pathCost>
    <castEdgeShadows>false</castEdgeShadows>
    <rotatable>true</rotatable>
    <hasInteractionCell>true</hasInteractionCell>
    <!-- The staff side. The customer side is the mirror of this through the counter,
         so the player chooses which way the shop faces just by rotating it. -->
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <size>(2,1)</size>
    <designationCategory>OWT_Commerce</designationCategory>
    <stuffCategories>
      <li>Woody</li>
      <li>Metallic</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>75</costStuffCount>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>1400</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>4</Beauty>
    </statBases>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <inspectorTabs>
      <li>OldWestTown.UI.ITab_ShopStock</li>
    </inspectorTabs>
    <researchPrerequisites>
      <li>OWT_FrontierCommerce</li>
    </researchPrerequisites>
    <constructEffect>ConstructWood</constructEffect>
  </ThingDef>

  <ThingDef ParentName="OWT_CounterBase">
    <defName>OWT_ShopCounter</defName>
    <label>shop counter</label>
    <description>A serving counter for a general store. Goods laid out in the same room are offered for sale across it.\n\nA colonist assigned to Shopkeeping will stand at the counter and serve customers; goods will not sell without someone to sell them. Takings collect in the till.</description>
    <graphicData>
      <texPath>Things/Building/Commerce/ShopCounter</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,1)</drawSize>
      <damageData>
        <rect>(0,0.05,2,0.9)</rect>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Commerce/ShopCounter_north</uiIconPath>
    <comps>
      <li Class="OldWestTown.Shops.CompProperties_Business">
        <shopKind>OWT_GeneralStore</shopKind>
        <openAirRadius>9.9</openAirRadius>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="OWT_CounterBase">
    <defName>OWT_SaloonBar</defName>
    <label>saloon bar</label>
    <description>A long bar with a brass rail. Drink and hot food stored in the same room are served across it.\n\nPatrons pay well but will not wait long for a barkeep who isn't there.</description>
    <graphicData>
      <texPath>Things/Building/Commerce/SaloonBar</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,1)</drawSize>
      <damageData>
        <rect>(0,0.05,2,0.9)</rect>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Commerce/SaloonBar_north</uiIconPath>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>8</Beauty>
    </statBases>
    <comps>
      <li Class="OldWestTown.Shops.CompProperties_Business">
        <shopKind>OWT_Saloon</shopKind>
        <openAirRadius>7.9</openAirRadius>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="OWT_CounterBase">
    <defName>OWT_BarberChair</defName>
    <label>barber chair</label>
    <description>A padded chair and a mirror. A colonist assigned to Shopkeeping will cut hair here for anyone willing to wait and pay.</description>
    <graphicData>
      <texPath>Things/Building/Commerce/BarberChair</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,1)</drawSize>
      <damageData>
        <rect>(0,0.05,2,0.9)</rect>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Commerce/BarberChair_north</uiIconPath>
    <comps>
      <li Class="OldWestTown.Shops.CompProperties_Business">
        <shopKind>OWT_Barber</shopKind>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="OWT_CounterBase">
    <defName>OWT_HotelDesk</defName>
    <label>hotel desk</label>
    <description>A front desk with a rack of room keys. A colonist assigned to Shopkeeping will check guests into any vacant bed in the same room.\n\nGuests pay for the night up front, then sleep it off wherever there's a free bed — put the desk in the same room as the beds it's meant to book.</description>
    <graphicData>
      <texPath>Things/Building/Commerce/HotelDesk</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,1)</drawSize>
      <damageData>
        <rect>(0,0.05,2,0.9)</rect>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Commerce/HotelDesk_north</uiIconPath>
    <comps>
      <li Class="OldWestTown.Shops.CompProperties_Business">
        <shopKind>OWT_Hotel</shopKind>
      </li>
    </comps>
  </ThingDef>

  <!-- Deliberately not parented from a vanilla bed def — this repo has no access to Core's
       Defs to confirm an exact defName, and validate_defs.py does not check ParentName at all,
       so a typo there would surface only as a red error in-game. Built the same way
       OWT_CounterBase itself was: from BuildingBase, with everything a bed needs added by hand.
       No CompAssignableToPawn/_Bed — a rented bed's occupant is tracked by CompRentableBed
       instead; see CompRentableBed.cs for why. -->
  <ThingDef ParentName="BuildingBase">
    <defName>OWT_HotelBed</defName>
    <label>hotel bed</label>
    <description>A simple bed for a paying guest. Travellers with nowhere else to sleep rent one by the night at the hotel desk, then sleep until morning or until the room is needed again.</description>
    <thingClass>Building_Bed</thingClass>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <blockWind>false</blockWind>
    <fillPercent>0.3</fillPercent>
    <castEdgeShadows>false</castEdgeShadows>
    <rotatable>true</rotatable>
    <size>(1,2)</size>
    <designationCategory>OWT_Commerce</designationCategory>
    <stuffCategories>
      <li>Woody</li>
      <li>Metallic</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>50</costStuffCount>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>2</Beauty>
      <Comfort>0.6</Comfort>
      <BedRestEffectiveness>1.0</BedRestEffectiveness>
      <RestRateMultiplier>1.0</RestRateMultiplier>
    </statBases>
    <building>
      <bed_humanlike>true</bed_humanlike>
      <bed_showSleeperBody>true</bed_showSleeperBody>
    </building>
    <graphicData>
      <texPath>Things/Building/Commerce/HotelBed</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,2)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/Commerce/HotelBed_north</uiIconPath>
    <researchPrerequisites>
      <li>OWT_FrontierCommerce</li>
    </researchPrerequisites>
    <constructEffect>ConstructWood</constructEffect>
    <comps>
      <li Class="OldWestTown.Shops.CompProperties_RentableBed" />
    </comps>
  </ThingDef>

</Defs>
