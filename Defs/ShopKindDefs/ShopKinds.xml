<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <OldWestTown.Shops.ShopKindDef>
    <defName>OWT_GeneralStore</defName>
    <label>general store</label>
    <description>Dry goods, tools, cloth and provisions. The backbone of any frontier town.</description>
    <customerNoun>customer</customerNoun>
    <defaultMarkup>1.35</defaultMarkup>
    <markupRange>0.5~3.0</markupRange>
    <appeal>1.0</appeal>
    <customerPatienceTicks>2500</customerPatienceTicks>
    <defaultStockCategories>
      <li>Foods</li>
      <li>Manufactured</li>
      <li>ResourcesRaw</li>
      <li>Medicine</li>
      <li>Apparel</li>
      <li>Textiles</li>
      <li>Leathers</li>
    </defaultStockCategories>
  </OldWestTown.Shops.ShopKindDef>

  <OldWestTown.Shops.ShopKindDef>
    <defName>OWT_Saloon</defName>
    <label>saloon</label>
    <description>Drink and a hot meal. Patrons are less patient than shoppers and pay well for the privilege.</description>
    <customerNoun>patron</customerNoun>
    <defaultMarkup>1.8</defaultMarkup>
    <markupRange>0.5~4.0</markupRange>
    <appeal>1.4</appeal>
    <!-- A thirsty patron will not stand at an empty bar for long. -->
    <customerPatienceTicks>1500</customerPatienceTicks>
    <defaultStockCategories>
      <li>Drugs</li>
      <li>FoodMeals</li>
    </defaultStockCategories>
    <services>
      <li>OWT_Drink</li>
      <li>OWT_Meal</li>
    </services>
  </OldWestTown.Shops.ShopKindDef>

  <OldWestTown.Shops.ShopKindDef>
    <defName>OWT_Barber</defName>
    <label>barber shop</label>
    <description>A chair, a mirror, and a steady hand. Customers pay for a haircut and a bit of conversation.</description>
    <customerNoun>customer</customerNoun>
    <defaultMarkup>1.5</defaultMarkup>
    <markupRange>0.5~3.0</markupRange>
    <appeal>1.1</appeal>
    <customerPatienceTicks>2200</customerPatienceTicks>
    <services>
      <li>OWT_Haircut</li>
    </services>
  </OldWestTown.Shops.ShopKindDef>

</Defs>
