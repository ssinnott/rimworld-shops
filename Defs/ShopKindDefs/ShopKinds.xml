<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <OldWestTown.Shops.ShopKindDef>
    <defName>OWT_GeneralStore</defName>
    <label>general store</label>
    <description>Dry goods, tools, cloth and provisions. The backbone of any frontier town.</description>
    <customerNoun>customer</customerNoun>
    <defaultMarkup>1.35</defaultMarkup>
    <markupRange>0.5~3.0</markupRange>
    <appeal>1.0</appeal>
    <customerPatienceTicks>2500</customerPatienceTicks>
    <defaultStockCategories>
      <li>Foods</li>
      <li>Manufactured</li>
      <li>ResourcesRaw</li>
      <li>Medicine</li>
      <li>Apparel</li>
      <li>Textiles</li>
      <li>Leathers</li>
    </defaultStockCategories>
  </OldWestTown.Shops.ShopKindDef>

  <OldWestTown.Shops.ShopKindDef>
    <defName>OWT_Saloon</defName>
    <label>saloon</label>
    <description>Drink and a hot meal. Patrons are less patient than shoppers and pay well for the privilege.</description>
    <customerNoun>patron</customerNoun>
    <defaultMarkup>1.8</defaultMarkup>
    <markupRange>0.5~4.0</markupRange>
    <appeal>1.4</appeal>
    <!-- A thirsty patron will not stand at an empty bar for long. -->
    <customerPatienceTicks>1500</customerPatienceTicks>
    <defaultStockCategories>
      <li>Drugs</li>
      <li>FoodMeals</li>
    </defaultStockCategories>
    <services>
      <li>OWT_Drink</li>
      <li>OWT_Meal</li>
    </services>
  </OldWestTown.Shops.ShopKindDef>

  <OldWestTown.Shops.ShopKindDef>
    <defName>OWT_Barber</defName>
    <label>barber shop</label>
    <description>A chair, a mirror, and a steady hand. Customers pay for a haircut and a bit of conversation.</description>
    <customerNoun>customer</customerNoun>
    <defaultMarkup>1.5</defaultMarkup>
    <markupRange>0.5~3.0</markupRange>
    <appeal>1.1</appeal>
    <customerPatienceTicks>2200</customerPatienceTicks>
    <services>
      <li>OWT_Haircut</li>
    </services>
  </OldWestTown.Shops.ShopKindDef>

  <OldWestTown.Shops.ShopKindDef>
    <defName>OWT_Hotel</defName>
    <label>hotel</label>
    <description>A front desk and a row of rented beds. Travellers with nowhere else to sleep pay by the night.</description>
    <customerNoun>guest</customerNoun>
    <defaultMarkup>1.6</defaultMarkup>
    <markupRange>0.5~3.5</markupRange>
    <appeal>1.3</appeal>
    <!-- The most patient of the four kinds: a guest who's decided to rent a room for the night
         has more riding on it than a browser or a thirsty patron, so they'll wait for a key
         nearly twice as long as a saloon patron waits for a drink (1500). -->
    <customerPatienceTicks>2800</customerPatienceTicks>
    <services>
      <li>OWT_Lodging</li>
    </services>
  </OldWestTown.Shops.ShopKindDef>

  <OldWestTown.Shops.ShopKindDef>
    <defName>OWT_GamblingHall</defName>
    <label>gambling hall</label>
    <description>A faro table and a house that always has an edge. Gamblers come to bet, not to browse — what they leave with is down to the cards and the house's own nerve.</description>
    <customerNoun>gambler</customerNoun>
    <defaultMarkup>1.0</defaultMarkup>
    <markupRange>0.5~3.0</markupRange>
    <!-- Markup's twin dial — see HouseEdge on CompBusiness. A greedy edge is genuinely
         tempting (a much richer take per hand) and genuinely self-defeating (patrons lose
         faster, get angrier faster, and a shortfall is the worst reputation hit in the mod). -->
    <defaultHouseEdge>0.15</defaultHouseEdge>
    <houseEdgeRange>0.0~0.5</houseEdgeRange>
    <appeal>1.3</appeal>
    <customerPatienceTicks>1800</customerPatienceTicks>
    <services>
      <li>OWT_Wager</li>
    </services>
  </OldWestTown.Shops.ShopKindDef>

</Defs>
