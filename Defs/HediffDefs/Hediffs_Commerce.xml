<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Ticks up on every round of drinks a saloon serves — see ServiceWorker_Ingest.rowdinessPerServing
       and TroubleUtility.Notify_ServiceRound — and decays on its own via vanilla's own
       HediffCompProperties_SeverityPerDay: no custom HediffComp needed anywhere in this. Crossing
       the top stage fires a scripted disturbance and resets Severity to 0 in the same call, so
       that stage is never observable from a WorkGiver scan; the sheriff's reactive job targets
       the stage below it instead (see TroubleUtility.IsWorthCalming). -->
  <HediffDef>
    <defName>OWT_Rowdy</defName>
    <label>rowdy</label>
    <description>Getting louder, looser with their money, and a lot less patient. A saloon left to its own devices makes its patrons like this; an on-duty sheriff, or a skilled barkeep, slows it down.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <!-- Without this, HediffDef's own default (0.5) applies instead: every freshly-created
         instance would start already inside the "getting loud" stage, before a single drink's
         rowdinessPerServing is even added. -->
    <initialSeverity>0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.5</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>feeling good</label>
        <minSeverity>0</minSeverity>
      </li>
      <li>
        <!-- The sheriff's reactive job's whole target window — see TroubleUtility.IsWorthCalming. -->
        <label>getting loud</label>
        <minSeverity>0.5</minSeverity>
      </li>
      <li>
        <!-- Fires the disturbance and resets to 0 in the same tick it's reached — see
             TroubleUtility.Notify_ServiceRound. Never observed from outside that method. -->
        <label>spoiling for a fight</label>
        <minSeverity>1.0</minSeverity>
      </li>
    </stages>
  </HediffDef>

</Defs>
