<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <JobDef>
    <defName>OWT_BuyFromShop</defName>
    <driverClass>OldWestTown.AI.JobDriver_BuyFromShop</driverClass>
    <reportString>buying TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <JobDef>
    <defName>OWT_ManShop</defName>
    <driverClass>OldWestTown.AI.JobDriver_ManShop</driverClass>
    <reportString>minding TargetA.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <JobDef>
    <defName>OWT_ServeDrink</defName>
    <driverClass>OldWestTown.AI.JobDriver_UseService</driverClass>
    <reportString>getting a drink at TargetB.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <JobDef>
    <defName>OWT_ServeMeal</defName>
    <driverClass>OldWestTown.AI.JobDriver_UseService</driverClass>
    <reportString>getting a meal at TargetB.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <JobDef>
    <defName>OWT_ServeHaircut</defName>
    <driverClass>OldWestTown.AI.JobDriver_UseService</driverClass>
    <reportString>getting a haircut at TargetB.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <!-- The colony's own side of the barber chair. A separate JobDef from OWT_ServeHaircut because
       it runs a separate driver: a colonist's visit ends in an effect, not a transaction. -->
  <JobDef>
    <defName>OWT_GetHaircut</defName>
    <driverClass>OldWestTown.AI.JobDriver_ColonistUseService</driverClass>
    <reportString>getting a haircut at TargetB.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

</Defs>
